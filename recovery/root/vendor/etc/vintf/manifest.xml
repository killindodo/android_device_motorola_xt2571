<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <version>1.1</version>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::IBootControl/default</fqname>
        <fqname>@1.1::IBootControl/default</fqname>
        <fqname>@1.2::IBootControl/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
            <instance>backup</instance>
        </interface>
        <fqname>@2.0::IHealth/default</fqname>
        <fqname>@2.0::IHealth/backup</fqname>
        <fqname>@2.1::IHealth/default</fqname>
        <fqname>@2.1::IHealth/backup</fqname>
    </hal>
</manifest>
